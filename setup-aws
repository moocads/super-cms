#!/bin/bash
# Setup AWS S3 bucket + Amazon SES email + IAM user (single user for both)
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== Strapi AWS Setup: S3 + SES + IAM ===${NC}\n"

# Check dependencies
for cmd in aws jq openssl; do
  if ! command -v $cmd &> /dev/null; then
    echo -e "${RED}Error: '$cmd' is required but not installed.${NC}"
    exit 1
  fi
done

# Project name
read -p "Enter project name (lowercase, letters/numbers/hyphens): " PROJECT_NAME
PROJECT_NAME=$(echo "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr '_' '-')
if [ -z "$PROJECT_NAME" ]; then
  echo -e "${RED}Project name cannot be empty.${NC}"
  exit 1
fi

# S3 region
read -p "Enter S3 region [ca-central-1]: " S3_REGION_INPUT
S3_REGION="${S3_REGION_INPUT:-ca-central-1}"

# SES region
read -p "Enter SES region [us-east-1]: " SES_REGION_INPUT
SES_REGION="${SES_REGION_INPUT:-us-east-1}"

# Sender email for SES
read -p "Enter sender email address to verify with SES: " SES_FROM_EMAIL
if [ -z "$SES_FROM_EMAIL" ]; then
  echo -e "${RED}Sender email cannot be empty.${NC}"
  exit 1
fi

BUCKET_NAME="${PROJECT_NAME}-mooc"
IAM_USER="${PROJECT_NAME}-strapi"
POLICY_NAME="${PROJECT_NAME}-strapi-policy"

# ─── S3 Bucket ─────────────────────────────────────────────────────────────────
echo -e "\n${YELLOW}--- Creating S3 bucket: ${BUCKET_NAME} (${S3_REGION}) ---${NC}"

bucket_result=$(aws s3api create-bucket \
  --bucket "$BUCKET_NAME" \
  --region "$S3_REGION" \
  --create-bucket-configuration LocationConstraint="$S3_REGION" 2>&1) || true

if echo "$bucket_result" | grep -q '"Location"'; then
  echo -e "${GREEN}Bucket created: $BUCKET_NAME${NC}"
else
  echo -e "${RED}Bucket creation failed: $bucket_result${NC}"
  exit 1
fi

aws s3api delete-public-access-block --bucket "$BUCKET_NAME"
aws s3api delete-bucket-ownership-controls --bucket "$BUCKET_NAME" 2>/dev/null || true

# Allow public reads for uploaded media
aws s3api put-bucket-policy --bucket "$BUCKET_NAME" --policy "{
  \"Version\": \"2012-10-17\",
  \"Statement\": [{
    \"Effect\": \"Allow\",
    \"Principal\": \"*\",
    \"Action\": \"s3:GetObject\",
    \"Resource\": \"arn:aws:s3:::${BUCKET_NAME}/*\"
  }]
}"

echo -e "${GREEN}Public-read policy applied to bucket.${NC}"

# ─── SES Email Verification ─────────────────────────────────────────────────────
echo -e "\n${YELLOW}--- Setting up Amazon SES (${SES_REGION}) ---${NC}"

aws ses verify-email-identity --email-address "$SES_FROM_EMAIL" --region "$SES_REGION"
echo -e "${YELLOW}Verification email sent to: $SES_FROM_EMAIL${NC}"
echo -e "${YELLOW}Click the link in that email before sending through SES.${NC}"

# ─── IAM User + Policy ──────────────────────────────────────────────────────────
echo -e "\n${YELLOW}--- Creating IAM user: ${IAM_USER} ---${NC}"

POLICY_DOC="{
  \"Version\": \"2012-10-17\",
  \"Statement\": [
    {
      \"Effect\": \"Allow\",
      \"Action\": [\"s3:*\"],
      \"Resource\": [
        \"arn:aws:s3:::${BUCKET_NAME}\",
        \"arn:aws:s3:::${BUCKET_NAME}/*\"
      ]
    },
    {
      \"Effect\": \"Allow\",
      \"Action\": [
        \"ses:SendEmail\",
        \"ses:SendRawEmail\"
      ],
      \"Resource\": \"*\"
    }
  ]
}"

policy_result=$(aws iam create-policy \
  --policy-name "$POLICY_NAME" \
  --policy-document "$POLICY_DOC")

POLICY_ARN=$(echo "$policy_result" | jq -r '.Policy.Arn')
if [ -z "$POLICY_ARN" ] || [ "$POLICY_ARN" = "null" ]; then
  echo -e "${RED}Failed to create IAM policy.${NC}"
  exit 1
fi

aws iam create-user --user-name "$IAM_USER"
aws iam attach-user-policy --user-name "$IAM_USER" --policy-arn "$POLICY_ARN"

access_key_result=$(aws iam create-access-key --user-name "$IAM_USER")
KEY_ID=$(echo "$access_key_result" | jq -r '.AccessKey.AccessKeyId')
KEY_SECRET=$(echo "$access_key_result" | jq -r '.AccessKey.SecretAccessKey')

if [ -z "$KEY_ID" ] || [ "$KEY_ID" = "null" ]; then
  echo -e "${RED}Failed to create IAM access key.${NC}"
  exit 1
fi

echo -e "${GREEN}IAM user created: $IAM_USER${NC}"

# ─── Write to .env ───────────────────────────────────────────────────────────────
touch .env

{
  echo ""
  echo "# AWS S3 (file uploads)"
  echo "AWS_BUCKET=${BUCKET_NAME}"
  echo "AWS_ACCESS_KEY_ID=${KEY_ID}"
  echo "AWS_ACCESS_SECRET=${KEY_SECRET}"
  echo "AWS_REGION=${S3_REGION}"
  echo ""
  echo "# AWS SES (email) - same IAM user as S3"
  echo "AWS_SES_KEY=${KEY_ID}"
  echo "AWS_SES_SECRET=${KEY_SECRET}"
  echo "AWS_SES_REGION=${SES_REGION}"
  echo "AWS_SES_FROM_EMAIL=${SES_FROM_EMAIL}"
} >> .env

# ─── Summary ─────────────────────────────────────────────────────────────────────
echo -e "\n${GREEN}=== AWS Setup Complete ===${NC}"
echo -e "  S3 Bucket:   ${GREEN}${BUCKET_NAME}${NC}  (region: ${S3_REGION})"
echo -e "  SES Region:  ${GREEN}${SES_REGION}${NC}"
echo -e "  IAM User:    ${GREEN}${IAM_USER}${NC}"
echo -e "  Credentials saved to ${GREEN}.env${NC}"
echo -e "\n${YELLOW}Next steps:${NC}"
echo -e "  1. Verify ${SES_FROM_EMAIL} by clicking the link in your inbox"
echo -e "  2. Run ${GREEN}./publish-heroku${NC} to deploy"
