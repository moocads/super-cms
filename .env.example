HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database (development - sqlite)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# AWS S3 (file uploads)
AWS_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_ACCESS_SECRET=your-secret-access-key
AWS_REGION=ca-central-1
# AWS_ACL=public-read

# AWS SES (email) - can reuse same IAM credentials as S3
AWS_SES_KEY=your-access-key-id
AWS_SES_SECRET=your-secret-access-key
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=your-verified-email@example.com
