#!/bin/bash
# Deploy Strapi to Heroku with PostgreSQL, S3, and SES fully configured
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== Strapi Heroku Deployment ===${NC}\n"

# Check .env exists
if [ ! -f .env ]; then
  echo -e "${RED}Error: .env not found. Run ./setup-aws first.${NC}"
  exit 1
fi

# Helper: read a value from .env
get_env() {
  grep -E "^${1}=" .env | cut -d= -f2- | head -1
}

# Check all required AWS vars are present
REQUIRED_VARS="AWS_BUCKET AWS_ACCESS_KEY_ID AWS_ACCESS_SECRET AWS_REGION AWS_SES_KEY AWS_SES_SECRET AWS_SES_REGION AWS_SES_FROM_EMAIL"
for var in $REQUIRED_VARS; do
  val=$(get_env "$var")
  if [ -z "$val" ]; then
    echo -e "${RED}Error: $var is missing in .env. Run ./setup-aws first.${NC}"
    exit 1
  fi
done

read -p "Enter Heroku app name: " APP_NAME
if [ -z "$APP_NAME" ]; then
  echo -e "${RED}App name cannot be empty.${NC}"
  exit 1
fi

# Create Heroku app
echo -e "\n${YELLOW}--- Creating Heroku app: ${APP_NAME} ---${NC}"
heroku create "$APP_NAME"

# Verify app was created
if ! heroku apps:info --app "$APP_NAME" &>/dev/null; then
  echo -e "${RED}Failed to create Heroku app.${NC}"
  exit 1
fi

# Add PostgreSQL addon
echo -e "\n${YELLOW}--- Adding PostgreSQL addon ---${NC}"
heroku addons:create heroku-postgresql:essential-0 --app "$APP_NAME"

# Wait for DATABASE_URL to be provisioned
echo "Waiting for database to provision..."
sleep 5

# Generate and set security tokens
echo -e "\n${YELLOW}--- Setting security tokens ---${NC}"
heroku config:set \
  APP_KEYS="$(openssl rand -base64 32),$(openssl rand -base64 32)" \
  API_TOKEN_SALT="$(openssl rand -base64 32)" \
  ADMIN_JWT_SECRET="$(openssl rand -base64 32)" \
  TRANSFER_TOKEN_SALT="$(openssl rand -base64 32)" \
  JWT_SECRET="$(openssl rand -base64 32)" \
  NODE_ENV=production \
  --app "$APP_NAME"

# Set Heroku URL
MY_HEROKU_URL=$(heroku info --app "$APP_NAME" -s | grep web_url | cut -d= -f2)
heroku config:set MY_HEROKU_URL="$MY_HEROKU_URL" --app "$APP_NAME"

# Set AWS S3 vars
echo -e "\n${YELLOW}--- Setting AWS S3 variables ---${NC}"
heroku config:set \
  AWS_BUCKET="$(get_env AWS_BUCKET)" \
  AWS_ACCESS_KEY_ID="$(get_env AWS_ACCESS_KEY_ID)" \
  AWS_ACCESS_SECRET="$(get_env AWS_ACCESS_SECRET)" \
  AWS_REGION="$(get_env AWS_REGION)" \
  --app "$APP_NAME"

# Set AWS SES vars
echo -e "\n${YELLOW}--- Setting AWS SES variables ---${NC}"
heroku config:set \
  AWS_SES_KEY="$(get_env AWS_SES_KEY)" \
  AWS_SES_SECRET="$(get_env AWS_SES_SECRET)" \
  AWS_SES_REGION="$(get_env AWS_SES_REGION)" \
  AWS_SES_FROM_EMAIL="$(get_env AWS_SES_FROM_EMAIL)" \
  --app "$APP_NAME"

# Push to Heroku
echo -e "\n${YELLOW}--- Pushing to Heroku ---${NC}"
heroku git:remote -a "$APP_NAME"
git push heroku master

# Open in browser
heroku open --app "$APP_NAME"

echo -e "\n${GREEN}=== Deployment Complete ===${NC}"
echo -e "  App URL: ${GREEN}${MY_HEROKU_URL}${NC}"
echo -e "  Admin:   ${GREEN}${MY_HEROKU_URL}admin${NC}"
